# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings

# Build
build/
DerivedData/
*.moved-aside
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# Generated Metal library. Built by Scripts/build-shaders.sh from
# Sources/SwiftShaders/Metal/*.metal — never edited by hand, never committed.
# CI regenerates it; `make build` and `make test` depend on it.
Sources/SwiftShaders/Resources/*.metallib

# CocoaPods
Pods/

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# macOS
.DS_Store
*.swp
*~.nib
*.pbxuser
!default.pbxuser

# IDE
*.xcuserstate
*.xcscmblueprint
*.idea/
